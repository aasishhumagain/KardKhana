{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KardKhana: Run on Android Emulator",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/tools/run-android-emulator.mjs", "--watch"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instancePolicy": "silent"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
